/*
 * tileparity - main configuration.
 *
 * What runs is defined in main.nf / workflows / modules; WHERE and HOW it runs is
 * chosen with profiles, e.g.
 *     -profile laptop,docker,gpu                      (your workstation)
 *     -profile uzh_rolandgarros,apptainer             (SLURM cluster, Apptainer)
 *     -profile uzh_rolandgarros,conda                 (SLURM cluster, no containers)
 *     -profile test,docker                            (synthetic smoke test)
 */

manifest {
    name            = 'miguelrosell/tileparity'
    author          = 'Miguel Rosell'
    homePage        = 'https://github.com/miguelrosell/tileparity'
    description     = 'Harmonised H&E tiling so that UNI2-h, fastLBP and spatial transcriptomics describe the same tiles'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.04.0'
    version         = '0.6.1'
    defaultBranch   = 'main'
}

params {
    // Three levels (README, docs/usage.md):
    //   1. core: the standard run, on by default - tiles, input images, UNI2-h, fastLBP,
    //      expression per tile and the exported objects;
    //   2. optional analyses, off by default: --qc_umap, --cluster (with its cohort summary and
    //      tile galleries), --redundancy, --relevance, --patch_sweep;
    //   3. diagnostics, off by default: alternatives and checks that were used to take a
    //      design decision (docs/decisions.md); kept so that the decision can be re-checked.
    // Defaults never change between these groups without a note in CHANGELOG.md.

    // ======================================================================================
    // 1. CORE
    // ======================================================================================

    // ---- input / output -----------------------------------------------------------------
    input                  = null      // samplesheet CSV (docs/usage.md)
    outdir                 = 'results'
    publish_dir_mode       = 'copy'
    publish_images         = false     // also publish the large resampled and channels images
    config_profile_name    = null

    // ---- Process 1: scales, tiles, tissue mask, QC ----------------------------------------
    scales_mpp             = '0.2857,0.5,1.0'  // target µm/px; tile = tile_px * mpp (64, 112, 224 µm)
    tile_px                = 224
    upsample_tolerance     = 0.02      // a scale needing more upsampling than this is skipped
    resample_kernel        = 'lanczos3'
    image_compression      = 'deflate' // lossless compression of intermediate images
    min_tissue             = 0.5       // minimum tissue fraction of a kept tile (column keep)
    min_tissue_extract     = null      // features are computed from this tissue fraction on (null: = min_tissue)
    qc_tissue_thresholds   = '0.3,0.5,0.8' // thresholds drawn in prepare/<id>.tissue_thresholds.png
    min_st_coverage        = 0.5       // Visium HD grid: minimum fraction of the tile covered by bins
    hd_bin_um              = 8         // Visium HD bin size used for aggregation (2, 8 or 16)
    visium_tiling          = 'grid'    // standard Visium / HEST: 'grid' (no overlap, spots split by area) or 'spot'
    visium_split           = 'multinomial' // grid: each molecule of a spot goes to one tile ('multinomial') or 'fraction'
    visium_spot_um         = 55        // Visium spot diameter (µm), for the area shares
    min_spot_overlap       = 0.25      // Visium grid: minimum spots' worth of capture area in a kept tile
    split_seed             = 1         // random seed of the multinomial split (recorded in the lineage)
    mask_method            = 'saturation' // automatic tissue mask: saturation | grey | od (a samplesheet 'mask' overrides it)
    mask_mpp               = 4.0
    mask_smooth_um         = 8.0
    mask_min_value         = 0.10
    mask_close_um          = 16.0
    mask_fill_holes_um2    = 20000
    mask_min_object_um2    = 20000
    blur_mad               = 3.0       // flag tiles this many robust SDs below the slide's sharpness
    drop_blurred           = false     // default: blurred tiles are kept and only flagged (blur_flag)

    // ---- Process 1b: the input images of both extractors -----------------------------------
    // Input sets: 'rgb' = the slide; 'rgb_he' = the slide rebuilt from haematoxylin and eosin only
    stain_vectors          = 'slide'   // H and E colours: 'slide' (estimated per slide, Macenko) or 'standard'
    he_h_max               = 0.30      // haematoxylin amount mapped to 255 (H channel; fixed for all samples)
    he_e_max               = 0.15      // eosin amount mapped to 255 (E channel)

    // ---- Process 2b: fastLBP ----------------------------------------------------------------
    skip_lbp               = false
    lbp_channels           = 'rgb,rgb_he' // input sets (alternatives, never concatenated): rgb, rgb_he; also he, h, e (the stain amounts)
    lbp_radii              = null      // e.g. '1,2,3'; default: fastLBP progression up to tile_px / 4
    lbp_npoints            = null      // default: ceil(2 * pi * R)
    lbp_max_radius         = null

    // ---- Processes 1a + 2a: UNI2-h ----------------------------------------------------------
    skip_uni2h             = false
    uni2h_inputs           = 'rgb,rgb_he' // input sets, one 1536-d block each: rgb, rgb_he
    uni2h_weights          = null      // path to pytorch_model.bin; otherwise downloaded with $HF_TOKEN
    uni2h_test_mode        = false     // random 1-block network: for pipeline tests only
    uni2h_precision        = 'fp16'    // fp32 | fp16 | bf16 (GPU only; CPU always runs fp32)
    uni2h_batch_size       = 32
    use_gpu                = false     // set by -profile gpu

    // ---- Process 4: exports -----------------------------------------------------------------
    skip_spe               = false
    skip_anndata           = false
    export_combined        = true      // also write one object per scale with all samples

    // ======================================================================================
    // 2. OPTIONAL ANALYSES (off by default)
    // ======================================================================================

    // ---- 3-D UMAP of every view per scale (qc/) ---------------------------------------------
    qc_umap                = false

    // ---- clustering of every view per slide, and how much the views agree (cluster/) -------
    cluster                = false
    cluster_views          = 'all'     // UNI2H_RGB, UNI2H_RGB_HE, LBP_RGB, LBP_RGB_HE, LBP_HE, LBP_H, LBP_E, INTENSITY_HE, EXPRESSION (those computed)
    cluster_sets           = 'keep,extended' // tile sets: keep; extended = extracted tiles with enough RNA (sensitivity)
    cluster_methods        = 'leiden,kmeans' // Leiden (resolution searched to give exactly k clusters) and k-means
    cluster_k              = '2,3,4,6,8,10,12,15' // numbers of clusters compared between views
    cluster_k_ref          = 'auto'    // k of the heatmaps, maps and contingency tables: 'auto' (per method, the k at which the image views agree best with EXPRESSION) or a number
    cluster_n_pcs          = 50        // principal components per view
    cluster_n_neighbors    = 15        // neighbours of the Leiden graph (the tile itself included, as in Scanpy)
    cluster_n_hvg          = 2000      // most variable genes of the EXPRESSION view
    cluster_min_counts     = 0.1       // set extended: molecules per spatial unit >= this x the keep tiles' median
    cluster_null_shifts    = 100       // moves of the spatial null (0: no null)
    cluster_seed           = 0
    cluster_stability_reps = 5         // subsamples of the stability check (0: none)
    cluster_stability_fraction = 0.9   // share of the tiles in every subsample
    cluster_gallery        = true      // galleries of typical tiles per cluster and component (gallery/)
    cluster_gallery_n      = 8         // tiles per cluster and per end of a component
    cohort_summary         = true      // one summary per scale with every slide (cohort/)
    cohort_group           = 'condition' // samplesheet column whose groups the cohort summary compares
    cohort_pair            = 'patient' // samplesheet column of the unit: sections of one patient are averaged

    // ---- redundancy: how much of each image view the others predict (cluster/, needs --cluster)
    redundancy             = false
    redundancy_views       = 'images'  // every clustered view except EXPRESSION, or a comma list of views
    redundancy_folds       = 5         // folds of the spatial cross-validation
    redundancy_block_um    = 1000      // side of the square blocks of tissue that go to one fold (µm)
    redundancy_null_shifts = 20        // moves of the spatial null of R2 (also used by --relevance; 0: none)
    redundancy_bootstrap   = 200       // block-bootstrap resamples for the 95 % interval of R2 (also --relevance)

    // ---- relevance: how much of the expression (components, genes) each image view predicts
    //      (cluster/, needs --cluster; folds, blocks, null and bootstrap as for --redundancy)
    relevance              = false
    relevance_gene_views   = 'UNI2H_RGB,LBP_RGB,INTENSITY_HE' // views that predict every gene ('none': no gene level)
    relevance_gene_null_shifts = 20    // moves of the per-gene spatial null (0: none)

    // ---- patch size of fastLBP: expression predicted from LBP on patches of many sizes
    //      (patch_sweep/, Visium HD only)
    patch_sweep            = false
    patch_sweep_sizes_um   = '16:224:8' // patch sides (µm): start:end:step or a comma list; multiples of the cell
    patch_sweep_cell_um    = 8         // cell of the sweep (= the Visium HD bin used); patches are cells summed
    patch_sweep_channels   = 'rgb'     // input set of the LBP histograms of the sweep
    patch_sweep_max_radius = 8         // largest LBP radius used (px); radii above a quarter of a patch are dropped
    patch_sweep_k          = '4,8'     // k of the k-means ARI between LBP and expression at every size

    // ======================================================================================
    // 3. DIAGNOSTICS (off by default; docs/decisions.md)
    // ======================================================================================
    mask_compare           = false     // compare mask methods and finer mask resolutions (prepare/: figure + table)
    mask_compare_mpp       = '1.0,0.5' // finer resolutions of the comparison (µm/px)
    mask_compare_max_mpx   = 400       // larger comparison images are computed inside the tissue's bounding box
    lbp_center             = false     // also write LBP_CENTER_* (codes of the tile's central pixels only)
    cluster_lbp_recipes    = 'hellinger' // with --cluster: also prepare every LBP view as 'scanpy' (like expression) and/or 'zscore' (like UNI2-h)
    cluster_lbp_hvf        = 0.3       // recipe scanpy: share of the LBP bins kept (most variable)

    // ======================================================================================
    // SOFTWARE, SITE AND RESOURCES
    // ======================================================================================

    // ---- containers (see containers/ and .github/workflows/containers.yml) ----------------------
    container_python       = 'ghcr.io/miguelrosell/tileparity-python:0.6.0'
    container_uni2h        = 'ghcr.io/miguelrosell/tileparity-uni2h:0.6.0'
    container_r            = 'ghcr.io/miguelrosell/tileparity-r:0.6.0'

    // ---- SLURM site options (used by -profile uzh_rolandgarros and -profile slurm) -----------------
    slurm_queue            = null      // partition of the CPU jobs (null: the cluster's default)
    slurm_gpu_queue        = null      // partition of the GPU job (null: as slurm_queue)
    slurm_options          = null      // extra sbatch options for every job, e.g. '--account=xyz'
    slurm_gpu_options      = '--gres=gpu:1' // GPU request of the UNI2-h job

    // ---- resource ceilings: requests above these are reduced to fit the machine ---------------
    max_cpus               = 8
    max_memory             = '16.GB'
    max_time               = '48.h'

    // suffix of the execution report, timeline, trace and DAG file names
    trace_report_suffix    = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    debug {
        dumpHashes             = true
        process.beforeScript   = 'echo $HOSTNAME'
        cleanup                = false
    }
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        docker.envWhitelist    = 'HF_TOKEN'
        apptainer.enabled      = false
        singularity.enabled    = false
        conda.enabled          = false
    }
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        docker.enabled         = false
        singularity.enabled    = false
        conda.enabled          = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        apptainer.enabled      = false
        conda.enabled          = false
    }
    conda {
        conda.enabled          = true
        conda.channels         = ['conda-forge', 'bioconda']
        docker.enabled         = false
        apptainer.enabled      = false
        singularity.enabled    = false
    }
    mamba {
        conda.enabled          = true
        conda.useMamba         = true
        conda.channels         = ['conda-forge', 'bioconda']
        docker.enabled         = false
        apptainer.enabled      = false
        singularity.enabled    = false
    }
    wave {
        // builds the containers on the fly from containers/*/environment.yml (needs internet)
        wave.enabled           = true
        wave.freeze            = true
        wave.strategy          = 'conda,container'
        apptainer.ociAutoPull  = true
        singularity.ociAutoPull = true
    }
    gpu {
        params.use_gpu         = true
    }
    slurm {
        process.executor       = 'slurm'
        process.queue          = { params.slurm_queue }
        process.clusterOptions = { params.slurm_options ?: '' }
    }
    test {
        includeConfig 'conf/test.config'
    }
    laptop {
        includeConfig 'conf/laptop.config'
    }
    uzh_rolandgarros {
        includeConfig 'conf/uzh_rolandgarros.config'
    }
}

// Fail fast in the shell scripts of every task
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Keep the user's environment out of containers (except variables listed explicitly)
env {
    PYTHONNOUSERSITE = '1'
    R_PROFILE_USER   = '/.Rprofile'
    R_ENVIRON_USER   = '/.Renviron'
}

// No variable declarations here: Nextflow >= 25.10 parses configs with the strict syntax
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}
