/*
 * UZH server "rolandgarros" (128 CPUs, 512 GB RAM, NVIDIA L4 24 GB), jobs through SLURM.
 * Launch Nextflow from the login node (wimbledon) and combine with a software profile:
 *
 *     nextflow run miguelrosell/tileparity -profile uzh_rolandgarros,apptainer --input ... --outdir ...
 *     nextflow run miguelrosell/tileparity -profile uzh_rolandgarros,conda     --input ... --outdir ...
 *
 * TODO (ask the admin): confirm the partition name(s), the GPU gres string and whether
 * compute nodes reach the internet. Fill them in below; nothing else needs to change.
 */

params {
    config_profile_name        = 'UZH rolandgarros (SLURM)'
    use_gpu                    = true
    uni2h_batch_size           = 64      // NVIDIA L4, 24 GB
}

process {
    resourceLimits = [cpus: 64, memory: 400.GB, time: 72.h]
    executor       = 'slurm'
    // queue       = 'TODO_partition'          // e.g. 'standard'
    clusterOptions = ''

    withLabel: 'process_gpu' {
        // queue          = 'TODO_gpu_partition'
        clusterOptions = '--gres=gpu:1'          // TODO: may need '--gres=gpu:l4:1'
    }
}

executor {
    queueSize       = 20
    submitRateLimit = '10 sec'
    pollInterval    = '30 sec'
}

// Container images and conda environments are cached here (shared between runs)
apptainer.cacheDir   = "${System.getenv('HOME')}/.cache/tileparity/apptainer"
singularity.cacheDir = "${System.getenv('HOME')}/.cache/tileparity/singularity"
conda.cacheDir       = "${System.getenv('HOME')}/.cache/tileparity/conda"
