/*
 * Per-process options: command-line arguments (ext.args, built from params) and where
 * results are published. Changing a method parameter only needs a change here.
 * Every process also publishes its lineage file (<prefix>.<step>.lineage.json).
 */

process {

    withName: 'TILEPARITY_PREPARE' {
        ext.args = { [
            "--tile-px ${params.tile_px}",
            "--min-tissue ${params.min_tissue}",
            params.min_tissue_extract != null ? "--min-tissue-extract ${params.min_tissue_extract}" : '',
            "--tissue-thresholds ${params.qc_tissue_thresholds}",
            "--min-st-coverage ${params.min_st_coverage}",
            "--hd-bin-um ${params.hd_bin_um}",
            "--visium-tiling ${params.visium_tiling}",
            "--visium-spot-um ${params.visium_spot_um}",
            "--min-spot-overlap ${params.min_spot_overlap}",
            "--upsample-tolerance ${params.upsample_tolerance}",
            "--resample-kernel ${params.resample_kernel}",
            "--compression ${params.image_compression}",
            "--blur-mad ${params.blur_mad}",
            params.drop_blurred ? '--drop-blurred' : '',
            "--mask-method ${params.mask_method}",
            "--mask-mpp ${params.mask_mpp}",
            "--mask-smooth-um ${params.mask_smooth_um}",
            "--mask-min-value ${params.mask_min_value}",
            "--mask-close-um ${params.mask_close_um}",
            "--mask-fill-holes-um2 ${params.mask_fill_holes_um2}",
            "--mask-min-object-um2 ${params.mask_min_object_um2}",
            params.mask_compare ? "--mask-compare --mask-compare-mpp ${params.mask_compare_mpp} --mask-compare-max-mpx ${params.mask_compare_max_mpx}" : '',
        ].findAll().join(' ') }
        publishDir = [
            [
                path: { "${params.outdir}/${meta.sample}/mpp${meta.scale_tag}/prepare" },
                mode: params.publish_dir_mode,
                pattern: '*.{tsv.gz,tsv,json,png}'
            ],
            [
                path: { "${params.outdir}/${meta.sample}/mpp${meta.scale_tag}/prepare" },
                mode: params.publish_dir_mode,
                pattern: '*.resampled.tif',
                enabled: params.publish_images
            ]
        ]
    }

    withName: 'TILEPARITY_LBPCHANNELS' {
        ext.args = { "--channel-sets ${params.lbp_channels} --h-max ${params.he_h_max} --e-max ${params.he_e_max} --compression ${params.image_compression}" }
        publishDir = [
            [
                path: { "${params.outdir}/${meta.sample}/mpp${meta.scale_tag}/lbp" },
                mode: params.publish_dir_mode,
                pattern: '*.json'
            ],
            [
                path: { "${params.outdir}/${meta.sample}/mpp${meta.scale_tag}/lbp" },
                mode: params.publish_dir_mode,
                pattern: '*.channels.tif',
                enabled: params.publish_images
            ]
        ]
    }

    withName: 'FASTLBP_EXTRACT' {
        ext.args = { [
            "--channel-sets ${params.lbp_channels}",
            params.lbp_center ? '--center' : '',
            params.lbp_radii ? "--radii ${params.lbp_radii}" : '',
            params.lbp_npoints ? "--npoints ${params.lbp_npoints}" : '',
            params.lbp_max_radius ? "--max-radius ${params.lbp_max_radius}" : '',
        ].findAll().join(' ') }
        publishDir = [
            path: { "${params.outdir}/${meta.sample}/mpp${meta.scale_tag}/lbp" },
            mode: params.publish_dir_mode,
            pattern: '*.{h5,png,tsv,json}'
        ]
    }

    withName: 'UNI2H_DOWNLOAD' {
        publishDir = [enabled: false]
    }

    withName: 'UNI2H_EMBED' {
        ext.args = { [
            params.uni2h_test_mode ? '--test-mode' : '',
            "--precision ${params.uni2h_precision}",
            "--batch-size ${params.uni2h_batch_size}",
            params.use_gpu ? '--device cuda' : '--device cpu',
        ].findAll().join(' ') }
        containerOptions = { params.use_gpu ? (workflow.containerEngine in ['singularity', 'apptainer'] ? '--nv' : (workflow.containerEngine == 'docker' ? '--gpus all' : '')) : '' }
        publishDir = [
            path: { "${params.outdir}/${meta.sample}/mpp${meta.scale_tag}/uni2h" },
            mode: params.publish_dir_mode,
            pattern: '*.{h5,json}'
        ]
    }

    withName: 'TILEPARITY_AGGREGATEST' {
        ext.args = { "--hd-bin-um ${params.hd_bin_um} --split ${params.visium_split} --seed ${params.split_seed}" }
        publishDir = [
            path: { "${params.outdir}/${meta.sample}/mpp${meta.scale_tag}/st" },
            mode: params.publish_dir_mode,
            pattern: '*.{h5,tsv,json}'
        ]
    }

    withName: 'TILEPARITY_EXPORTANNDATA' {
        ext.args = { params.export_combined ? '' : '--no-combined' }
        publishDir = [
            path: { "${params.outdir}/export/mpp${meta.scale_tag}/anndata" },
            mode: params.publish_dir_mode,
            pattern: '*.{h5ad,json}'
        ]
    }

    withName: 'TILEPARITY_EXPORTSPE' {
        ext.args = { params.export_combined ? '' : '--no-combined' }
        publishDir = [
            path: { "${params.outdir}/export/mpp${meta.scale_tag}/spe" },
            mode: params.publish_dir_mode,
            pattern: '*.{rds,json}'
        ]
    }

    withName: 'TILEPARITY_QCUMAP' {
        publishDir = [
            path: { "${params.outdir}/qc/mpp${meta.scale_tag}" },
            mode: params.publish_dir_mode,
            pattern: '*.{html,tsv.gz,json}'
        ]
    }
}
