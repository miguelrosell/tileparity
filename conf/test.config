/*
 * Smoke test on a tiny synthetic slide (tests/data, regenerate with
 * tests/data/make_test_data.py). Runs in a few minutes on any laptop:
 *
 *     nextflow run . -profile test,docker
 *
 * UNI2-h runs in test mode (random 1-block network), so no Hugging Face token is
 * needed; the embeddings are meaningless and only check the plumbing.
 * The 0.2 µm/px scale is deliberately finer than the slide (0.25 µm/px) and must be
 * skipped with a warning.
 */

params {
    config_profile_name        = 'Test profile'
    input                      = "${projectDir}/tests/data/samplesheet_test.csv"
    outdir                     = 'results_test'
    scales_mpp                 = '0.2,0.5,1.0'
    uni2h_test_mode            = true
    uni2h_batch_size           = 4
    lbp_max_radius             = 14
}

process {
    resourceLimits = [cpus: 2, memory: 4.GB, time: 1.h]
}
