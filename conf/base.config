/*
 * Default resources per process label. Requests above the ceilings set by
 * --max_cpus / --max_memory / --max_time (or by a site profile) are reduced to fit,
 * so the same pipeline runs on an 8-core laptop and on a 128-core server.
 */

process {
    cpus   = { 1 * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 4.h * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    resourceLimits = [
        cpus  : params.max_cpus as int,
        memory: params.max_memory as nextflow.util.MemoryUnit,
        time  : params.max_time as nextflow.util.Duration
    ]

    withLabel: 'process_single' {
        cpus   = { 1 }
        memory = { 6.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_low' {
        cpus   = { 2 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = { 4 * task.attempt }
        memory = { 24.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withLabel: 'process_high' {
        cpus   = { 32 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 16.h * task.attempt }
    }
    withLabel: 'process_gpu' {
        cpus   = { 8 }
        memory = { 32.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
}
