/*
 * Workstation profile (e.g. ASUS TUF Dash F15: 8 cores, 16-32 GB RAM, RTX 3070 8 GB).
 * Combine with a container profile and, if the NVIDIA container toolkit is installed,
 * with the gpu profile:
 *
 *     nextflow run . -profile laptop,docker,gpu --input samplesheet.csv --uni2h_weights /path/pytorch_model.bin
 */

params {
    config_profile_name = 'Laptop / workstation'
    uni2h_batch_size    = 16   // fits 8 GB of GPU memory in fp16
}

process {
    resourceLimits = [cpus: 8, memory: 14.GB, time: 72.h]
}

executor {
    name      = 'local'
    cpus      = 8
    memory    = '14.GB'
}
